{
  "name": "Morse two-step verification — SRP shared test values (contract A13 §5)",
  "kdf": "passwordKdfAlgoSHA256SHA256PBKDF2HMACSHA512iter100000SHA256ModPow",
  "formulas": {
    "SH": "SHA256(salt | data | salt)",
    "PH1": "SH(SH(password, salt1), salt2)",
    "PH2": "SH(PBKDF2-HMAC-SHA512(PH1, salt1, 100000 iterations, 64 bytes), salt2)",
    "x": "PH2 as a big-endian integer",
    "v": "g^x mod p",
    "k": "H(p | g)",
    "A": "g^a mod p",
    "B": "(k·v + g^b) mod p",
    "u": "H(A | B)",
    "S_client": "(B − k·v)^(a + u·x) mod p",
    "S_server": "(A · v^u)^b mod p",
    "K": "H(S)",
    "M1": "H(H(p) xor H(g) | H(salt1) | H(salt2) | A | B | K)",
    "padding": "every big number (p, g, A, B, S, v) is big-endian, left-padded to 256 bytes wherever it is hashed or sent; x is 32 bytes"
  },
  "p": "",
  "g": "3",
  "source": "firebase/functions/morse-srp.js (Node crypto + BigInt); the gotd case reproduces gotd/td srp_test.go M1 exactly",
